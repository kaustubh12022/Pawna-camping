# ==========================================
# FRONTEND ENVIRONMENT TEMPLATE
# ==========================================
# Copy to .env for local overrides. Never commit .env.

# Backend base URL. Leave unset in development to use http://localhost:5000,
# or unset in production to use the built-in Render URL.
VITE_API_URL=

# Web-push public key (only needed if the frontend subscribes to push).
VITE_VAPID_PUBLIC_KEY=
