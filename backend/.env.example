# ==========================================
# BACKEND ENVIRONMENT TEMPLATE
# ==========================================
# Copy to .env and fill in real values. Never commit .env.

# --- Runtime ---
# Set to "production" on Render/Vercel. Local development uses "development".
NODE_ENV=development
PORT=5000

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawna-camping?retryWrites=true&w=majority

# --- Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters; 64 is recommended. Rotating this value signs every
# user out of every device.
JWT_SECRET=replace-with-a-64-character-random-string

# --- CORS ---
# Extra allowed origin (optional). The Vercel production domains are built in.
FRONTEND_URL=

# --- Uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Debugging ---
# Stack traces are NEVER returned unless BOTH of these are set. Leave unset in
# production, even temporarily.
# DEBUG_STACKS=true
